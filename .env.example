# ---- Pre-purchase chat widget ----------------------------------------------
# OpenRouter key for the FAQ bot. Without it the widget still runs, but every
# question falls through to lead capture instead of being answered.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Defaults to anthropic/claude-haiku-4.5.
# Confirm the slug against https://openrouter.ai/models - the catalogue changes.
# A small, cheap model is the right choice: the bot answers from a fixed corpus
# and refuses everything else.
OPENROUTER_MODEL=

# ---- Lead notifications ----------------------------------------------------
# THE destination for escalated chat leads. Personal inbox for now; point this
# at a shared support address or ticket intake when volume justifies it.
# Changing this value is the only edit required for that move.
NOTIFY_EMAIL=

# Resend API key. https://resend.com/api-keys
RESEND_API_KEY=

# The FROM address on notification emails. This is NOT your inbox - it is the
# sender, and Resend only allows domains you have verified.
#
#   Testing now:  onboarding@resend.dev
#                 Works with zero DNS setup, but only delivers to the email
#                 address that owns the Resend account. Fine while NOTIFY_EMAIL
#                 is your personal inbox.
#
#   Production:   verify getcalvo.com in Resend (Domains -> Add Domain, then
#                 add the SPF/DKIM records), then use something on it, e.g.
#                 notifications@getcalvo.com
#
# It does not need to be a real mailbox - replies go to the visitor, because
# lib/notify.ts sets replyTo to their address.
NOTIFY_FROM_EMAIL=
